# Operator Console runtime settings (non-secret).
#
# All values are build-time Vite settings. Never put tokens, OIDC secrets,
# passwords, or Session Cookies in this file. The browser application never
# stores identity or credentials in localStorage or URLs.

# REST base URL used by the production bundle. Empty means same-origin, which
# is the required deployment mode (the static build is served behind a proxy).
VITE_API_BASE_URL=

# Prometheus base URL used only by the Current Contract intranet development
# deployment for fixed, non-arbitrary queries. Empty disables direct
# Prometheus access. Admin API mode never falls back to this value.
VITE_PROMETHEUS_BASE_URL=/prometheus

# --- Vite dev-server proxy targets (not exposed to the client bundle) ---
# Current Contract API role (REST, WebSocket, /healthz, /readyz, /status, /metrics).
VITE_DEV_API_TARGET=http://127.0.0.1:8080
# Collector and replay ops ports, exposed by the dev proxy under
# /ops/collector and /ops/replay respectively.
VITE_DEV_COLLECTOR_OPS_TARGET=http://127.0.0.1:8081
VITE_DEV_REPLAY_OPS_TARGET=http://127.0.0.1:8082
# Prometheus root, exposed by the dev proxy under /prometheus.
VITE_DEV_PROMETHEUS_TARGET=http://127.0.0.1:9090
